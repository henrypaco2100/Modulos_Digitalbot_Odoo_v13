<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de contactos-->
<odoo>
   <data>
    <record model="ir.ui.view" id="sd_heredar_products_category_siat">
            <field name="name">sd_heredar_products_category_siat</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='first']" position="after">
                    <group name="factura_linea" string="Facturación en Linea">
                        <field name="sd_codigo_product_id" options="{'no_create': True, 'no_create_edit':True}"/>
                    </group>
                </xpath>
            </field>
    </record>
   </data>
</odoo>