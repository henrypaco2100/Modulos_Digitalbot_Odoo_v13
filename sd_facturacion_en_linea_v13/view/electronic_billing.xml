        <menuitem
                id="sd_menu_facturacion_siat"
                name="Facturación Siat"
                parent="account.menu_finance_configuration"
                action="sd_action_arbol_facturacion_electronica"
                groups="sd_facturacion_en_linea_v13.sd_facturacion_electronica_en_linea_group"
                sequence="3"/>
        <menuitem
                id="sd_menu_facturacion_en_linea"
                name="Facturación en Linea"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_facturacion_electronica"
                sequence="1"/>
        <menuitem
                id="sd_menu_products_service"
                name="Productos Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_product_service_siat"
                sequence="2"/>
        <menuitem
                id="sd_menu_mensaje_service"
                name="Mensajes Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_mensaje_service_siat"
                sequence="3"/>
        <menuitem
                id="sd_menu_metodo_pago_service"
                name="Métodos de Pago"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_metodo_pago_service_siat"
                sequence="3"/>
        <menuitem
                id="sd_menu_eventos_significativos"
                name="Eventos Significativos Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_evento_significativo_siat"
                sequence="4"/>
        <menuitem
                id="sd_menu_punto_venta"
                name="Punto Venta Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_punto_venta_siat"
                sequence="5"/>
        <menuitem
                id="sd_menu_emision_paquete"
                name="Emision Paquete Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_emision_paquete_siat"
                sequence="6"/>
        <menuitem
                id="sd_menu_emision_masiva"
                name="Factura Masiva"
                parent="account.menu_finance_receivables"
                action="sd_action_arbol_emision_masiva_siat"
                groups="sd_facturacion_en_linea_v13.sd_emision_masiva_group"
                sequence="1"/>
        <menuitem
                id="sd_menu_motivo_anulacion"
                name="Motivo anulacion Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_motivo_anulacion_siat"
                sequence="7"/>
        <menuitem
                id="sd_menu_leyenda_service"
                name="Leyenda Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_leyenda_service_siat"
                sequence="8"/>
        <menuitem
                id="sd_menu_sucursal_siat"
                name="Sucursales Siat"
                parent="sd_facturacion_en_linea_v13.sd_menu_facturacion_siat"
                action="sd_action_arbol_sucursal_factura_siat"
                sequence="8"/>
    </data>
