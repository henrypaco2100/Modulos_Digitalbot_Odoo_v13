<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de Factura ventas -->
<odoo>
    <data>
        <record model="ir.ui.view" id="account_move_factura_online">
            <field name="name">account.move.factura.online</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="sd_razon_social" readonly="0" attrs="{'invisible': ['|','|', ('sd_es_especial','=',True), ('sd_es_online','=',False), ('state', 'in', ('posted','cancel'))]}"/>
                    <field name="sd_nombre_facturado" attrs="{'invisible': ['|', ('sd_es_online','=',False), ('state', 'not in', ('posted','cancel'))], 'readonly':[('state','in',('posted','cancel'))]}"/>
                    <field name="sd_codigo_tipo_documento"  attrs="{'invisible': ['|','|', ('sd_es_especial','=',True), ('sd_es_online','=',False), ('state', 'in', ('posted','cancel'))]}"/>
                    <field name="sd_tipo_documento_facturado" attrs="{'invisible': ['|', ('sd_es_online','=',False), ('state', 'not in', ('posted','cancel'))], 'readonly':[('state','in',('posted','cancel'))]}"/>
                    <field name="sd_nro_documento"  attrs="{'invisible': ['|','|', ('sd_es_especial','=',True), ('sd_es_online','=',False), ('state', 'in', ('posted','cancel'))]}"/>
                    <field name="sd_nro_documento_facturado" attrs="{'invisible': ['|', ('sd_es_online','=',False), ('state', 'not in', ('posted','cancel'))], 'readonly':[('state','in',('posted','cancel'))]}"/>
                    <field name="sd_extension" attrs="{'invisible': ['|', ('sd_es_online','=',False), ('sd_codigo_tipo_documento', '!=', '1')], 'readonly':[('state','in',('posted','cancel'))]}"/>
                    <field name="sd_email"  attrs="{'invisible': ['|', ('sd_es_especial','=',True), ('sd_es_online','=',False)], 'readonly':[('state','in',('posted','cancel'))]}"/>
                </xpath>
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="sd_cambiar_endpoint" readonly="1" invisible="1"/>
                    <field name="sd_es_especial" invisible="1"/>
                    <field name="sd_codigo_excepcion" invisible="1"/>
                </xpath>
<!--                <xpath expr="/form/sheet/group/group[@id='header_right_group']/div[@class='o_td_label']" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': [('sd_es_online','=',True)]}</attribute>-->
<!--                </xpath>-->
<!--                <xpath expr="//field[@name='invoice_date']" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': [('sd_es_online','=',True)]}</attribute>-->
<!--                </xpath>-->
<!--                <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': [('sd_es_online','=',True)]}</attribute>-->
<!--                </xpath>-->
<!--                <xpath expr="//div[@class='d-flex']" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': [('sd_es_online','=',True)]}</attribute>-->
<!--                </xpath>-->
<!--                <xpath expr="/form/sheet/group/group[@id='header_right_group']/label" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': [('sd_es_online','=',True)]}</attribute>-->
<!--                </xpath>-->
                <xpath expr="//field[@name='journal_id']" position="before">
                    <field name="sd_codigo_documento_sector" attrs="{'invisible': [('sd_es_online','!=',True)]}"/>
                    <field name="sd_fecha_emision" attrs="{'invisible': [('sd_es_online','!=',True)]}"/>
                    <field name="sd_factura_original" attrs="{'invisible': ['|',('sd_es_online','!=',True), ('type','!=','out_refund')]}"/>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="groups">account.group_account_user,sd_facturacion_en_linea_v13.sd_facturacion_electronica_en_linea_group,sd_facturacion_en_linea_v13.sd_facturacion_electronica_en_linea_usuario_group</attribute>
                </xpath>
                <xpath expr="/form/sheet/group" position="after">
                    <group name="datos_factura" attrs="{'invisible': [('sd_es_online','!=', True)]}">
                        <field name="sd_es_online" invisible="1"/>
                        <group >
                            <field name="sd_codigo_clasificador_mp" invisible="1"/>
<!--                            <field name="sd_motivo_id" options="{'no_create': True, 'no_create_edit':True}" />-->
                            <field name="sd_metodo_pago" options="{'no_create': True, 'no_create_edit':True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="sd_nro_tarjeta" attrs="{'invisible': [('sd_es_tarjeta', '=', False)]}"/>
                            <field name="sd_cantidad_gift_card" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('sd_es_giftcard', '=', False)]}"/>
                            <field name="sd_es_giftcard" invisible="1"/>
                            <field name="sd_es_tarjeta" invisible="1"/>
                            <field name="sd_es_cafc" groups="sd_facturacion_en_linea_v13.sd_facturas_cafc_group"/>
                            <field name="sd_nro_cafc" attrs="{'invisible': [('sd_es_cafc','=',False)]}" groups="sd_facturacion_en_linea_v13.sd_facturas_cafc_group"/>
                            <field name="sd_codigo_cafc" attrs="{'invisible': [('sd_es_cafc','=',False)]}" groups="sd_facturacion_en_linea_v13.sd_facturas_cafc_group"/>
                        </group>
                        <group>
                            <field name="sd_descuento_adicional" groups="sd_facturacion_en_linea_v13.sd_facturas_monto_adicional_group" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
<!--                            <field name="sd_monto_total_sujeto_iva" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('state', '!=', 'posted')]}"/>-->
<!--                            <field name="sd_monto_total_moneda" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('state', '!=', 'posted')]}"/>-->
<!--                            <field name="sd_monto_descuento" attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('state', '!=', 'posted')]}"/>-->
                            <field name="sd_nro_factura_siat" readonly="1" attrs="{'invisible':[('state', '!=', 'posted')]}"/>
                            <field name="sd_codigo_documento_sector" invisible="1"/>
                            <field name="sd_periodo_inicio" attrs="{'invisible':[('sd_codigo_documento_sector', '!=', '2')], 'readonly':[('state','=','posted')]}"/>
                            <field name="sd_periodo_fin" attrs="{'invisible':[('sd_codigo_documento_sector', '!=', '2')], 'readonly':[('state','=','posted')]}"/>
                            <field name="sd_periodo_facturado" attrs="{'invisible':[('sd_codigo_documento_sector', '!=', '2')], 'readonly':[('state','=','posted')]}"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//page[@name='other_info']" position="after">
                    <page id="facturacion_linea"  string="Facturacion en Linea" attrs="{'invisible': [('sd_es_online','!=', True)]}">
                        <group>
                            <field name="sd_leyenda_id" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                        </group>
                        <group attrs="{'invisible': [('state', 'not in', ['posted','cancel'])]}">
                            <field name="sd_url_factura" widget="url" readonly='True' />
                        </group>
                        <group name="cuf_facturacion" attrs="{'invisible': [('state', 'not in', ['posted','cancel'])]}">
                            <field name="sd_cuf" readonly='True' />
                        </group>
                    </page>
                </xpath>
                <xpath expr="//group[@name='datos_factura']" position="before">
                    <group string="Casos especiales" name="datos_especiales" attrs="{'invisible': ['|',('sd_es_online','!=', True), ('sd_es_especial','!=', True)]}">
                        <field name="sd_es_especial" invisible="1"/>
                        <group col="1">
                            <field name="sd_caso_especial" widget='radio' options="{'horizontal': true}" attrs="{'invisible':[('sd_es_especial','!=',True)]}"/>
                        </group>
                        <br/>
                        <group>
                            <field name="sd_nit_especial"/>
                            <field name="sd_razon_social_especial" attrs="{'invisible': [('sd_caso_especial','=','1')], 'readonly': ['|',('sd_caso_especial','=','2'),('sd_caso_especial','=','3')]}"/>
                            <field name="sd_razon_social_extranjero" attrs="{'invisible': [('sd_caso_especial','!=','1')]}"/>
                        </group>
                        <group>
                            <field name="sd_correo_especial" attrs="{'invisible': [('sd_caso_especial','=','2')]}"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//button[@name='open_reconcile_view']" position="before">
                    <span class="float-left text-right" style='font-size:18px;text-transform: uppercase;padding-left:0%;padding-top:1.7%;padding-right:0%'>
                        <field name='sd_estado_siat' widget="label_selection" options="{'classes': {'sin_publicar': 'warning','anulada': 'danger','valida': 'success'}}"
                                invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
<!--                        <field name='state' widget="label_selection" options="{'classes': {'draft': 'default','cancel': 'warning','posted': 'success'}}"/>-->
                    </span>
                </xpath>
                <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                    <attribute name="name">action_imprimir_factura_enviar_correo_siat_sudo</attribute>
                </xpath>

            </field>
        </record>
        <record model="ir.ui.view" id="account_move_test_eventos">
            <field name="name">account.move.test.eventos</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_cancel']" position="after">
                    <button name="cambiar_endpoint" string="Cambiar endpoint" type="object" invisible="1"/>
                    <button name="open_wizard_anular_factura" string="Anular Factura" type="object" attrs="{'invisible': [('type','=','entry')]}"/>
                    <button name="action_verificar_factura_siat" string="Verificar Factura" type="object" attrs="{'invisible': [('type','=','entry')]}"/>
                </xpath>
            </field>
        </record>
