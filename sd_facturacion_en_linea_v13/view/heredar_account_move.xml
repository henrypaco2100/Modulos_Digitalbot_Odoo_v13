        <record model="ir.ui.view" id="account_move_list_factura_online">
            <field name="name">account.move.list.factura.online</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sd_nro_factura_siat" optional="show" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                    <field name="sd_fecha_emision" optional="show" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                </xpath>
                <xpath expr="//field[@name='invoice_partner_display_name']" position="after">
                    <field name="sd_codigo_tipo_documento" optional="hide" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                    <field name="sd_nro_documento" optional="hide" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                    <field name="sd_email" optional="hide" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                </xpath>
                <xpath expr="//field[@name='amount_total_signed']" position="after">
                    <field name="sd_metodo_pago" optional="hide" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                    <field name="sd_cuf" optional="hide" string="COD AUTORIZACIÓN" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                    <field name="sd_url_factura" optional="hide" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name='sd_estado_siat' widget="label_selection" options="{'classes': {'sin_publicar': 'warning','anulada': 'danger','valida': 'success'}}"
                            optional="show" invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                </xpath>
            </field>
        </record>

    </data>
    <data>
        <record model="ir.ui.view" id="sd_account_move_filter_facturacion_venta">
            <field name="name">sd.account.move._filter.facturacion.venta</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <search position="inside">
                    <field name="sd_nro_factura_siat"/>
                    <filter name="mi_facturacion_venta" string="Es Facturación Venta" domain="[('sd_es_online', '=', True)]"/>
                </search>
                <filter name="due_date" position="after">
                    <filter name="es_fecha_emision" string="Fecha Emisión" date="sd_fecha_emision"/>
                </filter>
                <filter name="status" position="after">
                    <filter name="sd_diario" string="Diario" context="{'group_by':'journal_id'}"/>
                    <filter name="sd_siat_emision_masiva_id" string="Facturas Masivas" context="{'group_by':'sd_siat_emision_masiva_id'}"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>