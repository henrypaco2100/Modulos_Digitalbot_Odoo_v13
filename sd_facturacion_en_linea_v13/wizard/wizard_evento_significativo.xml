<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_move_tree_crear_evento_significativo_wizard" model="ir.ui.view">
            <field name="name">Wizard</field>
            <field name="model">wizard.evento.significativo</field>
            <field name="arch" type="xml">
                <form string="Nuevo Evento Significativo">
                    <group>
                        <field name="sd_name"/>
                        <group>
                            <field name="sd_evento_id"/>
                            <field name="sd_cuis" readonly="1"/>

                        </group>
                        <group>
                            <field name="sd_cufd"/>
                            <field name="sd_cufd_antiguo"/>
                        </group>
                    </group>
<!--                    <field name="sd_online_billing_id">Factura</field>-->
                    <span class="o_form_label">¿Esta seguro de crear evento significativo?</span>
                    <footer>
                        <button string="Crear Evento Significativo" name="action_crear_evento_significativo" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

