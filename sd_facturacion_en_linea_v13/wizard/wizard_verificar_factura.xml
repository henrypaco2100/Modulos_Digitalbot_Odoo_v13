<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_move_tree_verificar_facturas_wizard" model="ir.ui.view">
            <field name="name">Wizard</field>
            <field name="model">wizard.verificar.facturas</field>
            <field name="arch" type="xml">
                <form string="Verificar Facturas">
                    <span class="o_form_label">¿Esta seguro de querer verificar estas facturas?</span>
                    <footer>
                        <button string="Verificar Facturas" name="action_verificar_facturas_multiples" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

