<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="online_billing_tree_crear_paquete_factura_wizard" model="ir.ui.view">
            <field name="name">Wizard</field>
            <field name="model">wizard.paquete.factura</field>
            <field name="arch" type="xml">
                <form string="Nuevo Paquete Facturas">
                    <group>
                        <field name="sd_name"/>
                        <group>
                            <field name="sd_facturas_ids" widget="one2many"/>
                        </group>
                    </group>
<!--                    <field name="sd_online_billing_id">Factura</field>-->
                    <span class="o_form_label">¿Esta seguro que desea publicar estas facturas por paquetes?</span>
                    <footer>
                        <button string="Crear Paquete" name="action_publicar_facturas_paquetes" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

