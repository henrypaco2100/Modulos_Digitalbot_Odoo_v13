<?xml version="1.0" encoding="utf-8"?>
<!-- Modificaciones en el Formulario de contactos-->
<odoo>
   <data>
    <record model="ir.ui.view" id="sd_heredar_campos_facturacion_electronica_linea">
            <field name="name">sd_heredar_campos_facturacion_electronica_linea</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="vat" position="after">
                    <field name="st_nombre_compañia_facturar"/>
                </field>
                <xpath expr="/form/sheet/group/group/field[@name='vat']"  position="attributes">
                    <attribute name='string'>Nit</attribute>
                </xpath>
            </field>
    </record>
   </data>
</odoo>