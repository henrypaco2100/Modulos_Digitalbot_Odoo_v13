<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="sd_mrp_production_action_duplicate">
         <field name="name">sd_mrp_production_action_duplicate</field>
         <field name="model">mrp.production</field>
         <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form/header/button[@name='action_cancel']" position="before">
                <button name="duplicate" type="object" string="Duplicar"
                attrs="{'invisible': [('state', 'not in', ['cancel','done'])]}"/>
             </xpath>
        </field>
    </record>
</odoo>