<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="sd_mrp_production_write_date_group">
         <field name="name">sd_mrp_production_write_date_group</field>
         <field name="model">mrp.production</field>
         <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
         <field name="arch" type="xml">
             <xpath expr="/form/sheet/group/group/field[@name='date_deadline']" position="before">
                 <field name="date_finished"
                        groups="sd_mrp_production_v13.sd_action_write_date_finished_state_done,sd_mrp_production_v13.sd_mrp_group_show_and_write_date_finished"
                 />
             </xpath>
             <xpath expr="/form/sheet/group/group/field[@name='date_deadline']" position="attributes">
                 <attribute name='invisible'>1</attribute>
             </xpath>
             <xpath expr="/form/sheet/group/group/div/field[@name='date_planned_start']" position="attributes">
                 <attribute name='invisible'>1</attribute>
             </xpath>
             <xpath expr="/form/sheet/group/group/div/field[@name='date_planned_finished']" position="attributes">
                 <attribute name='invisible'>1</attribute>
             </xpath>
             <xpath expr="/form/sheet/group/group/div/label[@for='date_planned_finished']" position="attributes">
                 <attribute name='invisible'>1</attribute>
             </xpath>
             <xpath expr="/form/sheet/group/group/div[@class='o_row o_td_label']" position="attributes">
                 <attribute name='invisible'>1</attribute>
             </xpath>
             <button name="button_scrap" position="after">
                 <button name="action_write_date_finished_in_done"
                         string="Actualizar Fecha final"
                         type="object"
                         groups="sd_mrp_production_v13.sd_action_write_date_finished_state_done"
                         attrs="{'invisible' : [('state','!=','done')]}"
                 />
             </button>
         </field>
    </record>

<!--    modificar date arbol-->
     <record model="ir.ui.view" id="sd_mrp_production_tree_write_date_group">
         <field name="name">sd_mrp_production_tree_write_date_group</field>
         <field name="model">mrp.production</field>
         <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
         <field name="arch" type="xml">
             <xpath expr="//field[@name='date_planned_start']" position="attributes">
                 <attribute name='invisible'>1</attribute>
             </xpath>
             <xpath expr="//field[@name='name']" position="after">
                 <field name="date_finished"/>
             </xpath>
         </field>
    </record>
</odoo>