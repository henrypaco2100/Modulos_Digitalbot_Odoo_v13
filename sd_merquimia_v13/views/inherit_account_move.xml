<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sd_inherit_account_move_mejora_form" model="ir.ui.view">
        <field name="name">inherit.account.move.mejora.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="/form/sheet/group/group/field[@name='company_id']" position="after">
                    <field name="invoice_user_id" string="Comercial"  attrs="{'invisible': [('type', '!=', 'out_invoice')]}"  />
                    <field name="team_id" attrs="{'invisible': [('type', '!=', 'out_invoice')]}"/>
             </xpath>
             <xpath expr="/form/sheet/notebook/page/group/group/field[@name='invoice_user_id']" position="attributes">
                   <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
             </xpath>
        </field>
    </record>

</odoo>