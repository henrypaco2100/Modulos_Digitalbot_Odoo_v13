<!--                                    string="Ventas" type="object"/>-->

<!--                        </div>-->
<!--                </xpath>-->
                <xpath expr="//field[@name='picking_id']" position="replace" >
                       <field name="picking_id" string="Transferencia"/>
                        <field name="currency_id" invisible="1" />
                </xpath>
                <xpath expr="//group">
                    <field name="location_id" position="attributes">
                        <attribute name="optional">hide</attribute>
                    </field>
                    <field name="location_dest_id" position="attributes">
                        <attribute name="optional">hide</attribute>
                    </field>
                </xpath>

                <xpath expr="//group" position="after">
                    <group>
                        <group string="Valoracion Productos">
<!--                            <field name="sd_qty"/>-->
                            <field name="cost_valuation_total" />
                            <field name="cost_valuation" />
                            <field name="landed_cost_unit" string="Costo Nuevo LC" invisible="1"/>
                            <field name="type_id" string="Tipo"/>
                        </group>
                        <group string="Valoracion Costo Destino">
                            <field name="costo_dest_total"/>
                            <field name="costo_dest"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="inherit_view_inventory_tree">
            <field name="name">inherit.stock.move.line.tree</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="before" >
                    <button name="action_wizard_saldo" class="btn btn-primary" type="object" string="Ver saldo"/>
                </xpath>
                <xpath expr="//field[@name='qty_done']" position="after">
<!--                    <field name="sd_qty"  optional="show"/>-->
                    <field name="cost_valuation_total" optional="show"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="cost_valuation" optional="show"/>
                    <field name="landed_cost_unit" string="Costo Nuevo LC" invisible="1"/>
                    <field name="type_id" string="Tipo"/>
                    <field name="sd_type" string="Tipo2" invisible="1"/>
                </xpath>
                <field name="location_id" position="replace">
                    <field name="location_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" optional="hide"/>
                </field>
                <field name="location_dest_id" position="replace">
                    <field name="location_dest_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="button_click_action" model="ir.actions.server">
            <field name="name">Actualizar Tipos</field>
            <field name="binding_model_id" ref="stock.model_stock_move_line" />
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="state">code</field>
            <field name="code">
if records:
    records._get_default_type_move()
</field>
<!--            <field name="model">stock.move.line</field>-->
        </record>

