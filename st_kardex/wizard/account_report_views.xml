<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="odoo_report_view_form" model="ir.ui.view">
            <field name="name">Odoo Report View kardex</field>
            <field name="model">kardex.report</field>
            <field name="arch" type="xml">
                <form string="Reporte Kardex Fisico Valorado">
                    <sheet>
                        <group>
                            <group col="1">
                                <field name="date_start" readonly="False"/>
                                <field name="date_end" readonly="False"/>
                                <field name="categ_id" options="{'no_create': True}" readonly="False" widget="many2many_tags"/>
                                <field name="seleccionalmacenes" options="{'no_create': True}" readonly="False" widget="many2many_tags"/>
<!--                                <field name="filtrarproductos"/>-->
                                <field name="seleccionproductos" options="{'no_create': True}" readonly="False" widget="many2many_tags"/>
                            </group>
                            <group col="2">
                                <field name="sd_notdetails"/>
                                <field name="filtraralmacenes"/>
                                <field name="filtrarcategorias"/>
                                <field name="filtrartipomov"/>
                                <field name="mostrar_ubicaciones"/>
                                <field name="sd_notdocuments"/>
                                <field name="sinvariantes"/>
                            </group>
                        </group>
                        <group>
                            <field name="excel_file" readonly="1" filename="file_name"/>
                            <field name="file_name" invisible="True"/>
                        </group>
                    </sheet>
                    <footer>
                        <!--<button name="print_pdf" string="Imprimir" type="object" default_focus="1"
                                class="oe_highlight"/>-->
                        <button name="action_report_kardex" string="Imprimir Excel" type="object" default_focus="1"
                            class="oe_highlight" context="{'report_type':'excel'}"/>
                        <button string="Cancelar" class="btn btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="odoo_report_view_tree" model="ir.ui.view">
            <field name="name">Odoo report view tree</field>
            <field name="model">kardex.report</field>
            <field name="arch" type="xml">
                <tree string="Reporte Kardex Fisico Valorado">
<!--                    <field name="name"/>-->
                    <field name="date_start"/>
                    <field name="date_end"/>
                </tree>
            </field>
        </record>

        <record id="odoo_report_view_action" model="ir.actions.act_window">
            <field name="name">Odoo report view action</field>
            <field name="res_model">kardex.report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="odoo_report_view_form"/>
            <field name="target">new</field>
        </record>
        <!-- This Menu Item must have a parent and an action -->
        <!-- This Menu Item Must have a parent -->
        <menuitem id="kardex_product_report_cat" name="Reporte de Kardex" parent="stock.menu_warehouse_report" sequence="500"/>
        <menuitem id="kardex_product_report" name="Impresion de Kardex Fisico" action="odoo_report_view_action"
                  parent="kardex_product_report_cat"/>
    </data>
</odoo>
