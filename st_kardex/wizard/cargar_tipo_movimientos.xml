<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="odoo_report_view_form" model="ir.ui.view">
            <field name="name">Odoo Report View kardex</field>
            <field name="model">kardex.report</field>
            <field name="arch" type="xml">
                <form string="Cargar Tipo de Movimientos">
                    <sheet>
                        <group>
                            <button name="action_load_move_types" string="Cargar" type="object" default_focus="1"
                            class="oe_highlight"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Cancelar" class="btn btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
