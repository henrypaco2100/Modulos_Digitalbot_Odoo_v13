<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        PWA ODOO 13 - CORRECCIÓN REAL

        En Odoo 13 el webclient utiliza:

            <t t-set="head_web">
                ...
            </t>

        y posteriormente:

            <t t-set="head" t-value="head_web + (head or '')"/>

        Por eso el manifest debe insertarse dentro de head_web.
    -->

    <template id="sh_pwa_webclient_head"
              name="PWA Webclient Head"
              inherit_id="web.webclient_bootstrap">

        <xpath expr="//t[@t-set='head_web']" position="inside">

            <!-- Manifest PWA -->
            <link rel="manifest"
                  id="shmanifiest"
                  t-att-href="'/manifest.json/' + str(request.env.user.company_id.id)"/>

            <!-- Icono para iPhone/iPad -->
            <link rel="apple-touch-icon"
                  id="iphone_shmanifiest"
                  sizes="180x180"
                  t-att-href="'/iphone.json/' + str(request.env.user.company_id.id)"/>

        </xpath>

    </template>


    <!--
        index.js continúa dentro de assets_backend
        porque registra el Service Worker.
    -->
    <template id="sh_pwa_assets_backend"
              name="PWA Backend Assets"
              inherit_id="web.assets_backend">

        <xpath expr="." position="inside">

            <script type="text/javascript"
                    src="/sh_pwa_backend/static/index.js"></script>

        </xpath>

    </template>

</odoo>