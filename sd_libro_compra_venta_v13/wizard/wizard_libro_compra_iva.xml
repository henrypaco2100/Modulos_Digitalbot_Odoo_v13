<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="wizard_libro_compra_iva" model="ir.ui.view">
            <field name="name">Libro Compra</field>
            <field name="model">wizard.libro.compra.iva</field>
            <field name="arch" type="xml">
                <form string="Libro Compra">
                    <span class="o_form_label">¿Desea crear los asientos?</span>
                    <footer>
                        <button string="Crear" name="action_verificar_facturas_multiples" type="object" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="sd_action_wizard_libro_compra_iva" model="ir.actions.act_window">
            <field name="name">Libro Compra Iva</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.libro.compra.iva</field>
            <field name="domain">[]</field>
            <field name="target">new</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="wizard_libro_compra_iva"/>
            <field name="binding_model_id" ref="model_compra_iva"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
