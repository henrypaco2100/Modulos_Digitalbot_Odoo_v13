<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_order_cancel_form" model="ir.ui.view">
            <field name="name">production.order.cancel</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_cancel']" position="replace">
                    <button name="action_cancel" states="draft,confirmed,done" type="object" string="Cancelar" groups="st_cancel_production_order.group_production_cancel" attrs="{'invisible': [('state', 'in', ['draft', 'cancel'])]}" confirm='¿Esta seguro que desea "Cancelar" la orden de Producción? '/>
                </xpath>
<!--                <xpath expr="//button[@name='action_confirm']" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': [('state', 'not in', ('draft', 'cancel'))]}</attribute>-->
<!--                </xpath>-->
            </field>
        </record>
</odoo>
