<?xml version="1.0"?>
<odoo>
    <!-- Form -->
    <record id="sd_view_automated_sale_users_form" model="ir.ui.view">
        <field name="name">sd.view.automated.sale.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group" position="after">
                <group string="Automates Sale permitidos" groups="bi_automated_sale_order.group_multi_automated_sale">
                    <field string="Automates permitidos" name="automated_sale_ids" widget="many2many_tags"/>
<!--                    <field string="Automate permitido" name="automated_sale_id" context="{'user_preference': 0}" attrs="{'required': [('automated_sale_ids','!=', [])]}"/>-->
                </group>
            </xpath>
        </field>
    </record>
</odoo>