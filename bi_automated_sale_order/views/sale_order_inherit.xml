<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sd_inherit_sale_order">
        <field name="name">inherit.inherit.sale.order.field</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='client_order_ref']" position="after">
                    <field name="sd_origen_venta_id" />
                    <field name="sd_venta_contable"/>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field/tree/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_open': True,'no_create': True, 'no_create_edit':True}</attribute>
                </xpath>
                <field name="work_process_order_id" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit':True}</attribute>
                </field>
            </field>
        </record>
    </data>
    <data>
        <record model="ir.ui.view" id="sd_sale_order_filter_inherit_v13">
                <field name="name">sd.sale.order.filter.inherit.v13</field>
                <field name="model">sale.order</field>
                <field name="inherit_id" ref="sale.view_sales_order_filter"/>
                <field name="arch" type="xml">
                    <search position="inside">
                        <field name="work_process_order_id"/>
                    </search>
                    <group position="inside">
                        <filter string="Tipo de Venta" name="tipo_venta_sd" domain="[]" context="{'group_by': 'work_process_order_id'}"/>
                    </group>
                </field>
        </record>
    </data>
</odoo>