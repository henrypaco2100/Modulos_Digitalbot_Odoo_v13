<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_txt_report_venta" model="ir.ui.view">
            <field name="name">view txt report venta</field>
            <field name="model">txt.report</field>
            <field name="arch" type="xml">
                <form string="Genrated txt File">
                    <group>
                        <field name="txt_filename" invisible="1"/>
                        <field name="txt_binary" readonly="1" filename="txt_filename" string ="Documeto"/>
                    </group>
                    <footer>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>