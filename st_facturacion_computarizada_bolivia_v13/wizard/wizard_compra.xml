<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record model='ir.ui.view' id='factura_compra_reporte_form'>
            <field name="name">factura compra reporte formulario wizard</field>
            <field name="model">factura.compra.reporte</field>
            <field name="arch" type="xml">
                <form string="reporte_compra">
                        <group string="diario compra">
                            <field name="diario_compra" widget="many2many_tags" />
                        </group>
                         <group col="4">
                            <field name="fecha_inicio"/>
                            <field name="fecha_final"/>
                        </group>
                    <footer>
                        <button name="export_xls_compra" type="object" default_focus="1"
                                string="Exportar Libro de Compra" class="oe_highlight"
                                 icon="fa-download"/>
                        <button name="generate_file_compra" type="object" string="Generar Archivo txt"
                                 icon="fa-download" class="oe_highlight"
                                />
                        <button string="Cancelar" class="oe_link" special="cancel"   />
                    </footer>
                </form>
            </field>
        </record>

        <record model='ir.actions.act_window' id='wizard_libro_compra'>
            <field name="name">Generar Reporte Libro de compra</field>
            <field name="res_model">factura.compra.reporte</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="factura_compra_reporte_form"/>
            <field name="target">new</field>
        </record>
        <menuitem name="Libro de Compra"
                  parent="exportar_libros_"
                  id="exportar_libro_de_compra"
                  action="wizard_libro_compra"
                  sequence="1"/>
    </data>

</odoo>
