<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record model='ir.ui.view' id='factura_venta_reporte_form'>
            <field name="name">factura venta reporte formulario wizard</field>
            <field name="model">factura.venta.reporte</field>
            <field name="arch" type="xml">
                <form string="reporte_venta">
                        <group string="diario venta">
                            <field name="diario_venta" widget="many2many_tags" />
                        </group>
                        <group col="4">
                            <field name="fecha_inicio"/>
                            <field name="fecha_final"/>
                        </group>
                    <footer>
                        <button name="export_xls" type="object" default_focus="1"
                                string="Exportar Libro de Ventas" class="oe_highlight"
                                 icon="fa-download"/>
                        <button name="generate_file_2" type="object" string="Generar Archivo txt"
                                 icon="fa-download" class="oe_highlight"
                                />
                        <button string="Cancelar" class="oe_link" special="cancel"   />
                    </footer>
                </form>
            </field>
        </record>

        <record model='ir.actions.act_window' id='wizard_libro_ventas'>
            <field name="name">Generar Reporte Libro de Ventas</field>
            <field name="res_model">factura.venta.reporte</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="factura_venta_reporte_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="exportar_libros_" name="Libros " parent="account.menu_finance_reports"/>
        <menuitem name="Libro de Ventas"
                  parent="exportar_libros_"
                  id="exportar_libro_de_ventas"
                  action="wizard_libro_ventas"
                  sequence="1"/>
    </data>

</odoo>
