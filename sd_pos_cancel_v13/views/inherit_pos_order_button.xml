<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sd_inherit_pos_order_button_button" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.button</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='refund']" position="attributes">
                <attribute name="attrs">{'invisible':[('state', 'in', ['draft', 'cancel'])]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>