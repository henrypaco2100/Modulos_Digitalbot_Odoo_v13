<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_order_cancel_form" model="ir.ui.view">
            <field name="name">sale.order.cancel</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_cancel']" position="replace">
                    <button name="action_cancel" states="draft,sent,sale" type="object" string="Cancelar" group="group_sale_cancel" confirm='¿Esta seguro que desea "Cancelar" la orden de Venta? '/>
                </xpath>
            </field>
        </record>
</odoo>
