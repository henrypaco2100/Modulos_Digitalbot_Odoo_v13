<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bi_financial_pdf_reports_form_general_ledger_custom_form" model="ir.ui.view">
        <field name="name">Libro mayor</field>
        <field name="model">accounting.report.bi</field>
        <field name="arch" type="xml">
        <form>
<!--            multIcompañia HENRY -->
<!--            <field name="sd_multicompañia" invisible ='True'/>-->
<!--            <div class="header" style='float:right'  attrs="{'invisible': [('sd_multicompañia','=', 'False')]}">-->
<!--                <strong><span class="o_stat_text" xml:space="preserve">Compañia  </span></strong>-->
<!--                <field name="sd_company_id"  widget="many2many_tags" />-->

<!--            </div>-->
            <group>
                <group>
                    <field name="target_move" widget="radio"/>
                    <field name="display_account" widget="radio"/>

                    <newline/>
                    </group>
                <group>
                    <field name="sortby" widget="radio"/>
                    <field name="initial_balance"/>
                    <newline/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="sd_tipo_reporte_libro_mayor"/>
                    </group>
            </group>
            <group>
                <field name="journal_ids" widget="many2many_tags"/>
                <field name="sd_account_id" widget="many2many_tags"/>
            </group>
            <footer>
                <button name="print_general_ledger" string="Imprimir" type="object" default_focus="1" class="oe_highlight"/>
                <button string="Cancel" class="btn btn-default" special="cancel" />
            </footer>
        </form>

        </field>
    </record>

    <record id="bi_financial_pdf_reports_action_general_ledger" model="ir.actions.act_window">
        <field name="name">Libro Mayor</field>
        <!--field name="name">General Ledger</field-->
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">accounting.report.bi</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bi_financial_pdf_reports_form_general_ledger_custom_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_account" />
        <field name="binding_type">report</field>
    </record>

    <menuitem
        id="bi_financial_pdf_reports_menu_general_ledger"
        name="Libro Mayor"
        parent="bi_menu_finance_report"
        action="bi_financial_pdf_reports_action_general_ledger"
       />
        <!--name="General Ledger"-->
</odoo>
