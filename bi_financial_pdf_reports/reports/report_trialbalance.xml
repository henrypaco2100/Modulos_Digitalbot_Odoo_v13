<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_trialbalance"><t t-call="web.html_container"><div class="page">
<h2 style="text-align:center; margin-bottom:15px;"><span t-esc="res_company.name"/>: Sumas y Saldos</h2>
<div style="font-size:10px; margin-bottom:12px;">
 <strong>Movimientos:</strong> <span t-if="data['target_move']=='all'">Todas las entradas</span><span t-if="data['target_move']=='posted'">Todas las entradas publicadas</span>
 <span style="margin-left:18px;"><strong>Mostrar:</strong> <span t-if="data['display_account']=='all'">Todas las cuentas</span><span t-if="data['display_account']=='movement'">Con movimientos</span><span t-if="data['display_account']=='not_zero'">Con saldo no igual a cero</span></span><br/>
 <t t-if="data['date_from']"><strong>Desde:</strong> <span t-esc="data['date_from']"/> </t><t t-if="data['date_to']"><strong style="margin-left:18px;">Hasta:</strong> <span t-esc="data['date_to']"/></t><br/>
 <t t-if="data.get('account_names')"><strong>Cuentas:</strong> <span t-esc="data['account_names']"/><br/></t>
 <t t-if="data.get('analytic_names')"><strong>Analítica:</strong> <span t-esc="data['analytic_names']"/><br/></t>
 <t t-if="data.get('partner_names')"><strong>Empresa:</strong> <span t-esc="data['partner_names']"/><br/></t>
 <t t-if="data.get('cash_flow_names')"><strong>CTA Flujo:</strong> <span t-esc="data['cash_flow_names']"/></t>
</div>
<table style="width:100%; border-collapse:collapse; font-size:11px;">
 <thead><tr style="background:#e6e9ed; border:1px solid #c9ced6;">
  <th style="width:16%; padding:6px; border:1px solid #c9ced6; text-align:left;">Código</th>
  <th style="width:42%; padding:6px; border:1px solid #c9ced6; text-align:left;">Cuenta</th>
  <th style="width:14%; padding:6px; border:1px solid #c9ced6; text-align:right;">Débito</th>
  <th style="width:14%; padding:6px; border:1px solid #c9ced6; text-align:right;">Crédito</th>
  <th style="width:14%; padding:6px; border:1px solid #c9ced6; text-align:right;">Balance</th>
 </tr></thead>
 <tbody><tr t-foreach="data.get('account_res')" t-as="account" t-att-style="'background:#fafafa;' if account.get('esi_detail') else ''">
  <td style="padding:5px 6px; border:1px solid #d7dbe0;"><span t-esc="account['code']"/></td>
  <td style="padding:5px 6px; border:1px solid #d7dbe0;"><span t-if="account.get('esi_detail')" style="padding-left:16px;">↳ </span><span t-esc="account['name']"/></td>
  <td style="padding:5px 6px; border:1px solid #d7dbe0; text-align:right;"><span t-esc="account['debit']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/></td>
  <td style="padding:5px 6px; border:1px solid #d7dbe0; text-align:right;"><span t-esc="account['credit']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/></td>
  <td style="padding:5px 6px; border:1px solid #d7dbe0; text-align:right;"><span t-esc="account['balance']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/></td>
 </tr></tbody>
</table>
</div></t></template>
</odoo>
