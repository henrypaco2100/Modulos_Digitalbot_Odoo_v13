<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_generalledger_v2">
        <t t-call="web.html_container">
            <t t-call="bi_financial_pdf_reports.sd_internal_layout_template_libro_mayor_v2">
<!--            <t t-set="data_report_margin_top" t-value="12"/>-->
<!--            <t t-set="data_report_header_spacing" t-value="9"/>-->
<!--            <t t-set="data_report_dpi" t-value="110"/>-->

<!--            <t t-call="web.internal_layout">-->

                <div class="page">
                        <div>
                            <div class="col">
                                <div style="margin-bottom: 5px; height: 30px">
                                    <div style="width: 50%; float:left; font-size:18px"><span t-esc="res_company.name"/></div>
                                    <div style="width: 50%; float:right; text-align:right"><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></div>
                                </div>
                                <div style="margin-bottom:10px;">
                                    <div style="width: 100% ;font-size:25px; text-align: center; ">Libro Mayor</div>
                                    <div style="width: 100% ;font-size:12px; text-align: center; ">Expresado en Bolivianos</div>
                                </div>
                            </div>

        <!--                    <div  style="width:99%; height:15px;margin-left:1%;">-->
        <!--                        <div>Nit:<span style="width:100%; height:50%" t-esc="data['nit']"/></div>-->
        <!--                    </div>-->

                            <div class="row" style="width: 100%; margin-left: 5px">
                                <div class="small" style="width:45%; margin-right: 10px; text-size: 10px">
                                    <strong>Diarios:</strong>
                                    <p style="text-size: 10px" t-esc="', '.join([ lt or '' for lt in print_journal ])"/>
                                </div>
                                <div class="small" style="width:25%; height: 100%; text-size: 10px">
                                    <strong>Mostrar cuenta</strong>
                                    <p>
                                        <span t-if="data['display_account'] == 'all'">Todas las cuentas'</span>
                                        <span t-if="data['display_account'] == 'movement'">Con movimientos</span>
                                        <span t-if="data['display_account'] == 'not_zero'">Con saldo no igual a cero</span>
                                    </p>
                                </div>
                                <div class="small" style="width:25%; height: 100%; text-size: 10px">
                                    <strong>Movimientos de destino:</strong>
                                    <p t-if="data['target_move'] == 'all'">Todas las entradas</p>
                                    <p t-if="data['target_move'] == 'posted'">Todas las entradas publicadas</p>
                                </div>
                            </div>

                            <div class="row" style="margin-left: 5px">
                                <div class="small" style="width:25%; text-size: 10px">
                                    <strong>Ordenado por:</strong>
                                    <div t-if="data['sortby'] == 'sort_date'"><p>Fecha</p></div>
                                    <div t-if="data['sortby'] == 'sort_journal_partner'">Diario y Asociado</div>
                                </div>
                                <div class="small" style="width:25%; text-size: 10px">
                                    <t t-if="data['date_from']">
                                        <strong>Fecha de :</strong>
                                        <div>
                                            <span t-esc="data['date_from']"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="small" style="width:25%; text-size: 10px">
                                    <t t-if="data['date_to']">
                                        <strong>Fecha hasta :</strong>
                                        <div>
                                            <span t-esc="data['date_to']"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                    <table class="table table-condensed table-sm table-bordered" style="table-layout: fixed; font-size: 10pt">
                        <thead class="thead-light">
                            <tr class="text-center">
                                <th width="9%">Fecha</th>
                                <th width="7%">Diario</th>
                                <th>asociado</th>
                                <th width="12%">Ref</th>
                                <th width="12%">Asiento</th>
                                <th width="14%">Etiqueta de entrada</th>
                                <th>Débito</th>
                                <th>Crédito</th>
                                <th>Balance</th>
<!--                                <th groups="base.group_multi_currency">Moneda</th>-->
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['Account']" t-as="account">
                                <tr style="font-weight: bold;">
                                    <td colspan="6">
                                        <span style="color: white;" t-esc="'..'"/>
                                        <span t-esc="account['code']"/>
                                        <span t-esc="account['name']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="account['debit']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="account['credit']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="account['balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
<!--                                    <td groups="base.group_multi_currency"/>-->
                                </tr>
                                <tr t-foreach="account['move_lines']" t-as="line">
                                    <td>
                                        <span t-esc="str(line['ldate'])"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['lcode']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['partner_name']"/>
                                    </td>
                                    <td>
                                        <span t-if="line['lref']" t-esc="line['lref']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['move_name']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['lname']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line['debit']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line['credit']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line['balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
<!--                                    <td class="text-right" groups="base.group_multi_currency">-->
<!--                                        <span t-esc="line['amount_currency'] if line['amount_currency'] else ''"/>-->
<!--                                        <span t-esc="line['currency_code'] if line['amount_currency']  else ''"/>-->
<!--                                    </td>-->
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div class="small" style="width:25%; text-size: 9px">
                        <div>Página <span class="page"/> de <span class="topage"/></div>
                    </div>
                </div>
            </t>
        </t>
    </template>
    <record id="sd_reporte_formato_papel_libro_mayor" model="report.paperformat">
    <field name="name">Libro Mayor</field>
    <field name="default" eval="True" />
    <field name="format">Letter</field>
    <field name="page_height">0</field>
    <field name="page_width">0</field>
    <field name="orientation">Landscape</field>
    <field name="margin_top">9</field>
    <field name="margin_bottom">9</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="header_line" eval="False" />
    <field name="header_spacing">70</field>
    <field name="dpi">100</field>
    <field name="report_ids" eval="[(4, ref('bi_financial_pdf_reports.action_report_general_ledger_v2'))]"/>
</record>

</odoo>
