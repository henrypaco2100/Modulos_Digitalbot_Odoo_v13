		<!-- 
			Financial Reports Contable
		-->
		<record id="bi_account_financial_report_profitandloss0" model="account.financial.report">
			<field name="name">Estado de Resultado Contable</field>
			<field name="sign">-1</field>
			<field name="type">sum</field>
			<field name="sd_tipo_reporte">estado_resultado</field>
		</record>

		<record id="bi_account_financial_report_income0" model="account.financial.report">
			<field name="name">Ingresos Contable</field>
			<field name="sign">-1</field>
			<field name="parent_id" ref="bi_account_financial_report_profitandloss0"/>
			<field name="display_detail">detail_with_hierarchy</field>
			<field name="type">account_type</field>
			<field name="st_tipo_reporte">estado_resultado</field>
			<field name="st_numero_orden">1</field>
			<field name="account_type_ids" eval="[(4,ref('account.data_account_type_other_income')), (4,ref('account.data_account_type_revenue'))]"/>
		</record>

