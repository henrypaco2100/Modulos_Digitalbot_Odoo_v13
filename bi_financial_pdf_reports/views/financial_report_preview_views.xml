<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ESI: pantalla integrada para revisar el reporte antes de descargarlo. -->
    <record id="view_esi_financial_report_preview_form" model="ir.ui.view">
        <field name="name">esi.financial.report.preview.form</field>
        <field name="model">esi.financial.report.preview</field>
        <field name="arch" type="xml">
            <form string="Vista previa del reporte" create="false" edit="false" delete="false">
                <header>
                    <button name="action_print_pdf" string="Descargar PDF" type="object"
                            class="oe_highlight" icon="fa-file-pdf-o"/>
                    <button name="action_print_excel" string="Descargar Excel" type="object"
                            class="oe_highlight" icon="fa-file-excel-o"
                            attrs="{'invisible': [('excel_available', '=', False)]}"/>
                </header>
                <sheet>
                    <field name="excel_available" invisible="1"/>
                    <field name="source_model" invisible="1"/>
                    <field name="source_id" invisible="1"/>
                    <field name="pdf_method" invisible="1"/>
                    <field name="excel_method" invisible="1"/>
                    <field name="excel_uses_report_type" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="html_content" widget="html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
