<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_esi_cash_flow" model="ir.ui.view">
        <field name="name">account.move.form.esi.cash.flow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="after">
                <field name="esi_cash_flow_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_esi_cash_flow" model="ir.ui.view">
        <field name="name">account.move.line.form.esi.cash.flow</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="esi_cash_flow_id"/>
            </xpath>
        </field>
    </record>
</odoo>
