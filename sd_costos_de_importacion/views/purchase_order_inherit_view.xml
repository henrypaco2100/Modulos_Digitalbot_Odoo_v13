<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="view_purchase_order_form" model="ir.ui.view">
            <field name="name">purchase.order.button.lc</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_cancel']" position="after">
                    <button name="button_create_lc" states="purchase" string="Generar Costes en Destino" type="object"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                     <button name="action_view_lc"
                            type="object"
                            class="oe_stat_button"
                            attrs="{'invisible': [('landed_costs_ids_count', '=', 0)]}">
                            <field name="landed_costs_ids_count" widget="statinfo" string="Costes en Destino"/>
                     </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
