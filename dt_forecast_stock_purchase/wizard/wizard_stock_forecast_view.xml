<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="wizard_stock_forecast_report_form_view" model="ir.ui.view">
            <field name="name">wizard.stock.forecast.form.view</field>
            <field name="model">wizard.stock.forecast</field>
            <field name="arch" type="xml">
                <form>
                    <field name="state" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <group states="choose">
                        <field name="company_id" required="1" groups="base.group_multi_company"
                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
                    </group>
                    <group col="4" states="choose">
                        <field name="fsp_range_from" required="1"/>
                        <field name="fsp_range_to" required="1"/>
                    </group>
                    <group col="4" states="choose">
                        <field name="fsp_cat_product" required="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="fsp_outlier_data"/>
                        <field name="fsp_forecast_horizon"/>
                    </group>
                    <group states="choose">
                        <field name="fsp_type_analisis" widget="radio" options="{'horizontal': true}" required="1"/>
                        <field name="fsp_report_to_show" widget="radio" options="{'horizontal': true}" required="1"/>
                    </group>
                    <div states="get">
                            <h2>Report Download</h2>
                            <p>File : <field name="data" readonly="1" filename="name"/></p>
                    </div>
                    <footer states ="choose">
                        <button name="print_report" string="PDF" type="object" class="oe_highlight" />
                        or
                        <button name="print_xls_report" string="XLS" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                    <footer states="get">
                        <button name="go_back" string="Go Back" type="object" class="oe_highlight" />
                        or
                        <button special="cancel" string="Close" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_wizard_stock_forecast">
            <field name="name">Stock Forecast Report</field>
            <field name="res_model">wizard.stock.forecast</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_stock_forecast_report_form_view" />
            <field name="target">new</field>
        </record>

        <menuitem action="action_wizard_stock_forecast" id="menu_stock_forecast_menu"
                  parent="account.menu_finance_reports"
                  groups="dt_forecast_stock_purchase.group_stock_forecast_report"/>
    </data>
</odoo>
