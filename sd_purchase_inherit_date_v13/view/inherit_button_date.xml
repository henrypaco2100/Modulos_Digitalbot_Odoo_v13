<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sd_form_inherit_date_purchase">
             <field name="name">sd_form_inherit_date_purchase</field>
             <field name="model">purchase.order</field>
             <field name="inherit_id" ref="purchase.purchase_order_form"/>
             <field name="arch" type="xml">
                  <button name="button_unlock" position="after">
                     <button name="action_actualizar_fechas"
                             string="Actualizar Fecha"
                             type="object"
                             groups="sd_purchase_inherit_date_v13.sd_group_adjustment_purchase"
                     />
                 </button>
                 <field name="date_order" position="after">
                     <field name="date_order_2"
                            groups="sd_purchase_inherit_date_v13.sd_group_adjustment_purchase"
                            attrs="{'invisible' : [('state', '!=', 'purchase')]}"
                            readonly="0"
                     />
                 </field>
             </field>
        </record>
    </data>
</odoo>