<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="sd_purchase_update_order">
         <field name="name">sodigitalim purchase update order</field>
         <field name="model">purchase.order</field>
         <field name="inherit_id" ref="purchase.purchase_order_form"/>
         <field name="arch" type="xml">
             <button name="button_cancel" position="after">
                 <button name="action_update_purchase_order"
                         string="Modificar Compra"
                         type="object"
                         groups="sd_modificar_venta_compra.sd_update_purchase_group"
                         attrs="{'invisible' : [('state','!=','purchase')]}"
                 />
             </button>
         </field>
    </record>
    <!--                 realizar el wizard de modificar Compra-->
    <record model='ir.actions.act_window' id='sd_action_wizard_purchase_order_modificar'>
        <field name="name">Modificar Pedido de Compra</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sd.purchase.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
    <record model='ir.ui.view' id='sd_wizard_purchase_update_form'>
        <field name="name">Update purchase order </field>
        <field name="model">sd.purchase.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Modificar Compra">
                <group>
                    <group >
                        <field name="purchase_id" invisible="True" />
                        <field name="partner_id" />
                        <field name="partner_ref"/>
                    </group>
                     <group  >
                         <field name ="date_order"/>
                         <field name="work_process_order_id"/>
                         <field name="company_id" invisible="1"/>
                         <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <h4 >Lineas del pedido</h4>
                <group>
                <field name="order_wizard_line_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="name" />
<!--                            <field name="account_id" />-->
                        <field name="product_qty" />
                        <field name="product_uom_qty" invisible="True"/>
                        <field name="price_unit"/>
                        <field name="product_uom_category_id" invisible="True"/>
                        <field name="product_uom" groups="uom.group_uom"/>
<!--                            <field name="tax_ids" />-->
                        <field name="price_subtotal"/>
                        <field name="purchase_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </tree>
                </field>
            </group>
                <footer>
                    <button name="confirmar_update_purchase" string="Confirmar" default_focus="1"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="oe_link" special="cancel"   />
                </footer>
            </form>
        </field>
    </record>
    <!--        update order purchase line wizard-->
    <record id="sd_purchase_order_wizard_line" model="ir.ui.view">
            <field name="name">sd purchase order wizard line</field>
            <field name="model">sd.purchase.order.wizard.line</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="name" />
<!--                            <field name="account_id" />-->
                            <field name="product_qty" />
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                            <field name="product_uom_category_id" invisible="True"/>
                            <field name="product_uom" groups="uom.group_uom"/>
<!--                            <field name="tax_ids" />-->
                            <field name="price_subtotal"/>
                            <field name="purchase_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>
</odoo>
