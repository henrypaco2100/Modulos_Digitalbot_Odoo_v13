<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="sd_sale_update_order">
         <field name="name">sodigitalim sale update order</field>
         <field name="model">sale.order</field>
         <field name="inherit_id" ref="sale.view_order_form"/>
         <field name="arch" type="xml">
             <button name="action_cancel" position="after">
                 <button name="action_update_sale_order"
                         string="Modificar Venta"
                         type="object"
                         groups="sd_modificar_venta_compra.sd_update_sale_group"
                         attrs="{'invisible' : [('state','!=','sale')]}"
                 />
             </button>
         </field>
    </record>
<!--                 realizar el wizard de modificar venta-->
    <record model='ir.actions.act_window' id='sd_action_wizard_sale_order_modificar'>
        <field name="name">Modificar Pedido de Venta</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sd.sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
    <record model='ir.ui.view' id='sd_wizard_venta_update_form'>
        <field name="name">Crear Factura Computarizada</field>
        <field name="model">sd.sale.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Modificar Venta">
                <group>
                    <group >
                        <field name="sale_id" invisible="True" />
                        <field name="partner_id"/>
                        <field name="work_process_order_id"/>
                    </group>
                     <group  >
                         <field name ="date_order"/>
                         <field name="payment_term_id"/>
                         <field name="company_id" invisible="1"/>
                         <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <h4 >Lineas del pedido</h4>
                <group>
                <field name="order_wizard_line_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="name" />
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="product_uom_category_id" invisible="True"/>
                        <field name="product_uom" groups="uom.group_uom"/>
                        <field name="price_subtotal"/>
                        <field name="sale_id" invisible="1"/>
                    </tree>
                </field>
            </group>
                <footer>
                    <button name="confirmar_update_sale" string="Confirmar" default_focus="1"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="oe_link" special="cancel"   />
                </footer>
            </form>
        </field>
    </record>
    <record id="sd_sale_order_wizard_line" model="ir.ui.view">
        <field name="name">sd sale order wizard line</field>
        <field name="model">sd.sale.order.wizard.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="name" />
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="product_uom_category_id" invisible="True"/>
                        <field name="product_uom" groups="uom.group_uom"/>
                        <field name="price_subtotal"/>
                        <field name="sale_id" invisible="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
</odoo>