<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <data>
        <record id="btc_view_account_move_pay_day_form" model="ir.ui.view">
            <field name="name">account.move.form.inherit.pay.day</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale_info_group']/field[@name='partner_bank_id']" position="after">
                        <field name="day" readonly="True" force_save="True"/>
                        <field name="sale_zone_id" readonly="True" force_save="True"/>
                </xpath>

            </field>
        </record>


        <record id="view_account_invoice_report_route_tree" model="ir.ui.view">
            <field name="name">Accounts Receivable Report</field>
            <field name="model">account.move</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Invoices" js_class="account_tree" sample="1" create="false" edit="false" delete="false">
                    <field name="partner_ref" string="Customer Code"/>
                    <field name="invoice_partner_display_name" invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund','in_receipt')" groups="base.group_user" string="Vendor"/>
                    <field name="invoice_partner_display_name" invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund','out_receipt')" groups="base.group_user" string="Customer"/>
                    <field name="invoice_user_id" optional="hide" invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund','out_receipt')" string="Sales Person" widget="many2one_avatar_user"/>

                    <field name="day" string="Pay Day"/>
                    <field name="sale_zone_id" string="Zone"/>
                    <field name="invoice_date" optional="show" invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund','out_receipt')" string="Invoice Date"/>
                    <field name="nro_factura"/>
                    <field name="amount_total" string="Total Sale" sum="Total"/>
                    <field name="amount_paid_tmp" string="Total Pay" sum="Total"/>
                    <field name="amount_residual" string="Amount Due" sum="Total"/>
                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
                    <field name="due_days_rute"/>
                    <field name="invoice_date_due" widget="remaining_days" optional="show" attrs="{'invisible': [['payment_state', 'in', ('paid', 'in_payment', 'reversed')]]}"/>
                    <field name="payment_state" widget="badge" decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')" attrs="{'invisible': [('payment_state', 'in', ('invoicing_legacy'))]}"/>
                </tree>
            </field>
        </record>



        <record id="view_account_move_invoice_filter" model="ir.ui.view">
            <field name="name">Accounts Receivable Report</field>
            <field name="model">account.move</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Partner Sale Zone">
                     <field name="journal_id"/>
                    <separator/>
                    <field name="invoice_user_id" string="Salesperson" domain="[('share', '=', False)]"/>
                </search>
            </field>
        </record>

         <record id="action_move_out_invoice_type_new" model="ir.actions.act_window">
            <field name="name">Accounts Receivable Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">search,tree,form</field>
             <field name="domain">[('move_type', '=', 'out_invoice'),('state', '=', 'posted')]</field>
            <field name="context">{'default_move_type': 'out_invoice'}</field>
             <field name="view_id" ref="view_account_invoice_report_route_tree"/>
             <field name="search_view_id" ref="view_account_move_invoice_filter"/>

        </record>

        <menuitem id="menu_action_move_out_invoice_type_new"
                  action="action_move_out_invoice_type_new"
                  name="Accounts Receivable Report"
                  sequence="16"
                  parent="account.menu_finance_reports"
        />

    </data>
</odoo>