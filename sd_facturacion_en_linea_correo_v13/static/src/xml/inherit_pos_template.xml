    <t t-extend="ReceiptScreenWidget">
        <t t-jquery="div.print" t-operation="after">
            <div  id="enviar_correo_siat" class="button correo" style="line-height: 40px;
                                                padding: 3px 13px;
                                                font-size: 20px;
                                                text-align: center;
                                                background: rgb(230, 230, 230);
                                                margin: 16px;
                                                margin-bottom: 0px;
                                                border-radius: 3px;
                                                border: solid 1px rgb(209, 209, 209);
                                                cursor: pointer;">
                enviar correo
            </div>

        </t>
    </t>

</template>