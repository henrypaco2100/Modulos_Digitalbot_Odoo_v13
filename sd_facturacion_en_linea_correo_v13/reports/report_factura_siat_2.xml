<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_factura_siat_2">
    <head>
        <link rel="stylesheet" type="text/css" href="/sd_facturacion_en_linea_correo_v13/static/src/css/style_factura_tasa_cero.css" />
    </head>
        <t t-call="web.html_container"><!--;border-radius:22px 5px;-->
            <t t-foreach="docs" t-as="factura">
                <t t-call="sd_facturacion_en_linea_correo_v13.sd_layout_facturacion_siat_account_move_2">
                    <div class="header" style="width:100%; ">
                        <div class="container-fluid">
                            <div class="row" style="width:100%;font-size: 12px;">
                                <div class="col" style="width:15%;float:left;padding-left:0px">
                                    <div style="padding-top:8px"><img t-attf-src="data:image/png;base64,{{factura.company_id.logo}}" height="100px" width="110px" alt="Red dot"/></div>
                                </div>
                                <div class="col" style="width:40%;float:left;">
                                    <div style="width:100%; height:100%;text-align: left;line-height: 1.3">
                                        <div><strong t-esc="factura.journal_id.sd_factura_online_id.sd_nombre_company" style="font-size: 18px"></strong></div>
                                        <div><strong t-esc="factura.obtener_sucursal_report()" style="font-size: 18px"></strong></div>
                                        <div xml:space="preserve">No. Punto de Venta <span style="padding-left:5px" t-esc="factura.obtener_nro_punto_venta()"></span></div>
                                        <div><span t-esc="factura.obtener_direccion()"/> </div>
                                        <div>Telefono:<span t-esc="factura.journal_id.sd_factura_online_id.sd_nro_company"/> </div>
                                        <div><span t-esc="factura.obtener_municipio()"/> </div>
                                    </div>
                                </div>

                                <div class="col" style="width:49%;heigth:100%;float:right;padding:10px 10px 10px 10px; line-height: 1.6;background-color:#E7E5E2;border-radius: 10px;">
                                    <div style="width:45%;heigth:100%;float:left;text-align: left;padding-left:10px">
                                        <div><strong>NIT</strong></div>
                                        <div><strong>
                                            <t t-if="factura.es_debito_credito()">
                                              NOTA Nº
                                            </t>
                                            <t t-else="">
                                              FACTURA Nº
                                            </t></strong></div>
                                        <div><strong>CÓD AUTORIZACIÓN</strong></div>
                                    </div>
                                    <div style="width:50%;heigth:100%;float:right;text-align:left">
                                        <div><span t-esc="factura.journal_id.sd_factura_online_id.sd_nit_em"/></div>
                                        <div><span t-esc="factura.get_nro_factura()"/></div>
                                        <div><span t-esc="factura.sd_cuf"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div class="row-cols-1" style="width:100%; font-size: 20px;">
                            <div class="col">
                                <center><strong><span t-esc="factura.get_titulo_documento()"/></strong></center>
                            </div>
                            <t t-if="not factura.es_debito_credito()">
                                <div class="col" style="width:100%; font-size: 12px;">
                                    <center><span t-esc="factura.get_tipo_factura()"/></center>
                                </div>
                            </t>
                        </div>
                        <br></br>
                        <div class="container-fluid" style="width:100%;font-size: 12px;">
                            <div class="row" >
                                <div class="col" style="width:60%">
                                    <div class="row" style="width:107%">
                                        <div class="col text-left" style="width:33%;padding-left:0%"><strong>Fecha: </strong>  </div>
                                        <div class="col text-left" style="width:67%;padding-left:0%"><span t-esc="factura.obtener_fecha_emision(factura.sd_fecha_emision)"/> <span t-esc="factura.obtener_hora_emision(factura.sd_fecha_emision)"/></div>
                                    </div>
                                    <div class="row" style="width:107%">
                                        <div class="col text-left" style="width:33%;padding-left:0%"><strong>Nombre/Razón Social:</strong></div>
                                        <div class="col text-left" style="width:67%;padding-left:0%"><span style="text-transform: uppercase" t-esc="factura.get_razon_social()"/></div>
                                    </div>
                                    <t t-if="factura.es_debito_credito()">
                                        <div class="row" style="width:107%;">
                                            <div class="col text-left" style="width:35%;padding-left:0%"><strong>Nº Factura:</strong></div>
                                            <div class="col text-left" style="width:65%;padding-left:0%"><span t-esc="factura.sd_factura_original.sd_nro_factura_siat"/></div>
                                        </div>
                                    </t>
                                </div>
                                <div class="col" style="width:40%">
                                    <div class="row" style="width:110%">
                                        <div class="col text-right" style="width:35%"><strong >NIT/CI/CEX:</strong> </div>
                                        <div class="col tex-left" style="width:65%;padding-left:20px"><span t-esc="factura.numero_documento_completo()"/></div>
                                    </div>
                                    <div class="row" style="width:110%">
                                        <div class="col text-right" style="width:35%"><strong>Cod. Cliente:</strong> </div>
                                        <div class="col text-left" style="width:65%;padding-left:20px"><span t-esc="factura.partner_id.id"/></div>
                                    </div>
                                    <t t-if="factura.es_debito_credito()">
                                        <div class="row" style="width:110%">
                                            <div class="col text-right" style="width:35%"><strong>Fecha Factura:</strong> </div>
                                            <div class="col text-left" style="width:65%;padding-left:20px"><span t-esc="factura.obtener_fecha_emision(factura.sd_factura_original.sd_fecha_emision)"/><span style="padding-left:5px" t-esc="factura.obtener_hora_emision(factura.sd_factura_original.sd_fecha_emision)"/></div>
                                        </div>
                                        <div class="row" style="width:110%">
                                            <div class="col text-right" style="width:35%"><strong>N° Autorización/CUF:</strong> </div>
                                            <div class="col text-left" style="width:65%;padding-left:20px"><span t-esc="factura.sd_factura_original.sd_cuf"/></div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <t t-if="factura.es_debito_credito()">
                        <br></br>
                        <div class="page">
                            <p class="titulo-factura-original-2">DATOS FACTURA ORIGINAL</p>
                            <table class="table table-sm table-bordered" style="font-size: 11px; color:black">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">CÓDIGO PRODUCTO</th>
                                        <th class="border-dark" style="text-align: center" scope="col" width="10%" height="30px">CANTIDAD</th>
                                        <th class="border-dark" style="text-align: center" scope="col" width="10%" height="30px">UNIDAD DE MEDIDA</th>
                                        <th class="border-dark" style="text-align: center" scope="col" width="20%" height="30px">DESCRIPCIÓN</th>
                                        <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">PRECIO UNITARIO</th>
                                        <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">DESCUENTO</th>
                                        <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">SUBTOTAL</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="factura.sd_factura_original.invoice_line_ids" t-as="linea">
                                        <tr>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style"  t-esc="linea.product_id.default_code or linea.product_id.id"/></td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.quantity" t-options = '{"widget": "float", "precision": 2}'/></td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.product_id.sd_unidad_medida_id.name"/></td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.name"/></td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.price_unit/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.get_discount_monto(linea.discount, linea.price_unit*linea.quantity)/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="(linea.quantity*linea.price_unit)-factura.get_discount_monto(linea.discount, linea.price_unit*linea.quantity)/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td class="invisible border-dark" colspan="4"></td>
                                        <td class="border-dark" colspan="2">MONTO TOTAL ORIGINAL BS</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="(factura.sd_factura_original.sd_monto_total_sujeto_iva + factura.sd_factura_original.sd_cantidad_gift_card + factura.sd_factura_original.sd_descuento_adicional)/factura.currency_id.rate"/></td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>
                    </t>
                    <div class="page">
                        <t t-if="factura.es_debito_credito()">
                            <p class="titulo-factura-original">DATOS DE LA DEVOLUCIÓN O RESCISIÓN</p>
                        </t>
                        <table class="table table-sm table-bordered" style="font-size: 11px;color:black">
                            <thead class="thead-light">
                                <tr>
                                    <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">CÓDIGO PRODUCTO</th>
                                    <th class="border-dark" style="text-align: center" scope="col" width="10%" height="30px">CANTIDAD</th>
                                    <th class="border-dark" style="text-align: center" scope="col" width="10%" height="30px">UNIDAD DE MEDIDA</th>
                                    <th class="border-dark" style="text-align: center" scope="col" width="20%" height="30px">DESCRIPCIÓN</th>
                                    <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">PRECIO UNITARIO</th>
                                    <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">DESCUENTO</th>
                                    <th class="border-dark" style="text-align: center" scope="col" width="15%" height="30px">SUBTOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="factura.invoice_line_ids" t-as="linea">
                                    <tr>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style"  t-esc="linea.product_id.default_code or linea.product_id.id"/></td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.quantity" t-options = '{"widget": "float", "precision": 2}'/></td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.product_id.sd_unidad_medida_id.name"/></td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.name"/></td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="linea.price_unit/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.get_discount_monto(linea.discount, linea.price_unit*linea.quantity)/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="(linea.quantity*round(linea.price_unit,2))-factura.get_discount_monto(linea.discount, round(linea.price_unit,2)*linea.quantity)/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                                <t t-if="not factura.es_debito_credito()">
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                        <td class="border-dark" colspan="2">SUBTOTAL Bs</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.get_sub_total()/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                        <td class="border-dark" colspan="2">DESCUENTO Bs</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.sd_descuento_adicional/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;">
                                            <div style="float:left;font-size: 10px;">
                                                <strong style="padding-left:10%;">Son: <span t-esc="factura.numero_to_letras(factura.sd_monto_total_sujeto_iva)" /> Bolivianos</strong>
                                            </div>
                                        </td>
                                        <td class="border-dark" colspan="2">TOTAL Bs</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="(factura.get_sub_total()-factura.sd_descuento_adicional)/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                        <td class="border-dark" colspan="2">MONTO GIFT CARD Bs</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.sd_cantidad_gift_card/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                        <td class="border-dark" colspan="2">MONTO A PAGAR Bs</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.sd_monto_total_sujeto_iva" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <t t-if="factura.currency_id.sd_tipo_moneda.sd_codigo_clasificador!=1">
                                        <tr>
                                            <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                            <td class="border-dark" colspan="2">MONTO A PAGAR Bs</td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.sd_monto_total_moneda" t-options = '{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                    </t>
                                    <t t-if="not factura.es_tasa_cero()">
                                        <tr>
                                            <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                            <td class="border-dark" colspan="2">IMPORTE BASE CRÉDITO FISCAL Bs</td>
                                            <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.sd_monto_total_sujeto_iva" t-options = '{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="factura.es_debito_credito()">
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;"></td>
                                        <td class="border-dark" colspan="2" >MONTO TOTAL DEVUELTO BS</td>
                                        <td class="border-dark" style="text-align: center"><div><span t-att-style="style" t-esc="factura.sd_monto_total_devuelto/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></div></td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" style="border-left-color: white;border-bottom-color: white;border-right-color: black;">
                                            <div style="float:left;font-size: 10px;">
                                                <strong style="padding-left:10%;">Son: <span t-esc="factura.numero_to_letras(factura.sd_monto_total_sujeto_iva)" /> Bolivianos</strong>
                                            </div>
                                        </td>
                                        <td class="border-dark" colspan="2">MONTO EFECTIVO DÉBITO-CRÉDITO BS</td>
                                        <td class="border-dark" style="text-align: center"><span t-att-style="style" t-esc="factura.sd_monto_efectivo_debito_credito/factura.currency_id.rate" t-options = '{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
<!--                        <div style="width:63.5%; height:120px;float:left;font-size: 10px;">-->
<!--                            <strong style="padding-left:10%;">Son: <span t-esc="factura.numero_to_letras(factura.sd_monto_total_sujeto_iva)" /> Bolivianos</strong>-->
<!--                        </div>-->
                    </div>
                    <div class="footer">
                        <div style="width:80%; height:100px;float:left;font-size: 10px;">
                            <br/>
                            <div>ESTA FACTURA CONTRIBUYE AL DESARROLLO DEL PAÍS, EL USO ILÍCITO SERÁ SANCIONADO PENALMENTE DE ACUERDO A LEY</div>
                            <br/>
                            <div><span t-esc="factura.obtener_leyenda_factura()"/></div>
                            <br/>
                            <div><span t-esc="factura.obtener_leyenda_emision()"/> </div>
                        </div>
                        <div style="width:20%; height:100px;float:right;font-size: 10px;">
                            <div style='float:left;width:16%;text-align:left'>
                                <img t-attf-src="data:image/png;base64,{{factura.generate_factura_qr_siat()}}"
                                     alt="Red dot" height="120px" width="120px"/>
                            </div>
                        </div>
                        <div style="font-size:10px; float:right">
                            <span class="page"/>  /  <span class="topage"/>
                        </div>
                    </div>
                 </t>
            </t>
        </t>

</template>

<record id="sd_factura_formato_papel_facturacion_en_linea_siat_2" model="report.paperformat">
    <field name="name">Facturacion en Linea Siat</field>
    <field name="default" eval="True" />
    <field name="format">Letter</field>
    <field name="page_height">0</field>
    <field name="page_width">0</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">85</field>
    <field name="margin_bottom">40</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="header_line" eval="False" />
    <field name="header_spacing">75</field>
    <field name="dpi">80</field>
    <field name="report_ids" eval="[(4, ref('sd_facturacion_en_linea_correo_v13.sd_action_imprimir_facturacion_siat_2'))]"/>
</record>
</odoo>