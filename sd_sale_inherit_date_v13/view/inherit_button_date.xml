<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sd_form_inherit_date_sale">
             <field name="name">sd_form_inherit_date_sale</field>
             <field name="model">sale.order</field>
             <field name="inherit_id" ref="sale.view_order_form"/>
             <field name="arch" type="xml">
                  <button name="action_cancel" position="after">
                     <button name="action_actualizar_fechas"
                             string="Actualizar Fecha"
                             type="object"
                             groups="sd_sale_inherit_date_v13.sd_group_adjustment_sale"
                     />
                 </button>
                 <field name="date_order" position="after">
                     <field name="date_order_2"
                            groups="sd_sale_inherit_date_v13.sd_group_adjustment_sale"
                            attrs="{'invisible' : [('state', '!=', 'sale')]}"
                            readonly="0"
                     />
                 </field>
             </field>
        </record>
    </data>
</odoo>