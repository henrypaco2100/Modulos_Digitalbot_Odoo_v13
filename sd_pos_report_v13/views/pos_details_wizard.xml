<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_details_wizard_session_filter" model="ir.ui.view">
        <field name="name">pos.details.wizard.form.session.filter</field>
        <field name="model">pos.details.wizard</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_details_wizard"/>
        <field name="arch" type="xml">

            <!-- ESI corrección: el modo tree nativo no muestra una forma cómoda
                 de quitar POS. Con many2many_tags cada POS vuelve a tener su X. -->
            <xpath expr="//field[@name='pos_config_ids']" position="replace">
                <field name="pos_config_ids"
                       string="Puntos de Venta"
                       widget="many2many_tags"
                       colspan="4"
                       nolabel="1"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>

            <!-- ESI corrección: filtro adicional por una o varias sesiones. -->
            <xpath expr="//group[field[@name='pos_config_ids']]" position="after">
                <group string="Sesiones">
                    <field name="session_ids"
                           string="Sesiones POS"
                           widget="many2many_tags"
                           colspan="4"
                           nolabel="1"
                           domain="[('config_id', 'in', pos_config_ids)]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
            </xpath>

            <!-- ESI corrección: primero se puede visualizar el reporte en HTML;
                 PDF y Excel XLSX quedan como salidas adicionales. -->
            <xpath expr="//footer" position="replace">
                <footer>
                    <button name="action_view_report"
                            string="Ver reporte"
                            type="object"
                            class="btn-primary"/>
                    <button name="generate_report"
                            string="Descargar PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx"
                            string="Descargar Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </xpath>
        </field>
    </record>
</odoo>
